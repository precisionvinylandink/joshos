# Copy to .env and fill in. .env is gitignored — never commit real values.
# Backend: Supabase project "joshos-sync" (shared with the legacy prototype).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 'desktop' (full JoshOS: JobOS + LifeOS) or 'web' (JobOS only; LifeOS stripped).
# Defaults to 'desktop' when unset. build:web forces 'web'.
VITE_BUILD_TARGET=desktop
